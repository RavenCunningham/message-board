<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Index</title>
</head>
<body>
  <%= title %>
  <br/>
  <a href="/new">New Message</a>
  <% for(let i = 0; i < messages.length; i++) { %>
    <ul>
      <li>
        <%= messages[i].text %>
      </li>
      <li>
        <%= messages[i].user %>
      </li>
      <li>
        <%= messages[i].added %>
      </li>
    </ul>
    <% } %>
</body>
</html>